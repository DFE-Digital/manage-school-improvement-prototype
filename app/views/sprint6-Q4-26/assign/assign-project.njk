{% extends "../includes/form-template.html" %}

{% extends "layouts/main.html" %}

{% block pageTitle %}
  Content page template – {{ serviceName }} – GOV.UK Prototype Kit
{% endblock %}

{% block header %}
  {% include "/layouts/dfe-header.html" %}
{% endblock %}

{% block beforeContent %}
  {{ govukBackLink({
    text: "Back",
    href: "javascript:window.history.back()"
  }) }}
{% endblock %}

{% block content %}

<div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">  
  
      <span class="govuk-caption-l">Cheltenham Spa Primary School</span>
      <h1 class="govuk-heading-l">
        Who will work with this school?
      </h1>

      <form action="../task-list" method="post" novalidate>

        {% block formQuestions %}
            
          {{ xGovukAutocomplete({
            id: "assigned-to",
            name: "assigned-to",
            value: data['assigned-to'],
            allowEmpty: false,
            hint: {
              text: "Enter the person's name."
            },
            items: [
              { text: "Bo Bergman" },
              { text: "Bob Roberts" },
              { text: "Boris Karloff" },
              { text: "Bonita Boyd" }
            ]
          }) }}

          <div class="govuk-button-group">
    
            <button type="submit" class="govuk-button" data-module="govuk-button">
                Assign
            </button>
            {# or&nbsp;&nbsp;<a class="govuk-link" href="">Unassign</a> #}

          </div>
    
        {% endblock %}

    </form>

{% endblock %}

{% block footer %}
{% include "/layouts/rsd-footer.html" %}
{% endblock %}