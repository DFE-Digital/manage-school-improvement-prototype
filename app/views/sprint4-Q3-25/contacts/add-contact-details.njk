{% extends "layouts/main.html" %}

{% block pageTitle %}
  Question page template – {{ serviceName }} – GOV.UK Prototype Kit
{% endblock %}

{% block beforeContent %}
  {{ govukBackLink({
    text: "Back",
    href: "javascript:window.history.back()"
  }) }}
{% endblock %}

{% block header %}
  {% include "/layouts/dfe-header.html" %}
{% endblock %}

{% block content %}

  <div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">

      <span class="govuk-caption-l">Cheltenham Spa Primary School</span>
      <h1 class="govuk-heading-l">
        Add contact
      </h1>

      <form class="form" action='../contacts' method="post">
        
        <div class="govuk-form-group">
          <fieldset class="govuk-fieldset" aria-describedby="contact-hint">

            <legend class="govuk-fieldset__legend govuk-fieldset__legend--m">
              <h2 class="govuk-fieldset__heading">
                Details of the 
                {% if data["otherRoleAnswer"] != "" %}
                  {{ data["otherRoleAnswer"] | lower }}  
                {% else %}
                  {{ data["role"] | lower }}
                {% endif %}
              </h2>
            </legend>

              {# Name #}
              {# <div class="govuk-form-group">
                <label class="govuk-label" for="full-name">
                  Full name
                </label>
                <input class="govuk-input govuk-!-width-three-quarters" id="full-name" name="contact-details-fullName" type="text" spellcheck="false" autocomplete="name">
              </div> #}

              {# Name #}
              {{ govukInput({
                label: {
                  text: "Full name"
              },
                id: "contact-details-fullName",
                classes: "govuk-!-width-three-quarters",
                name: "contact-details-fullName",
                autocomplete: "name",
                value: data['contact-details-fullName'],
                spellcheck: false
              }) }}

              {# Email address #}
              {# <div class="govuk-form-group">
                <label class="govuk-label" for="email">
                  Email address
                </label>
                <input class="govuk-input govuk-!-width-three-quarters" id="email" name="contact-details-email" type="email" spellcheck="false" aria-describedby="email-hint" autocomplete="email">
              </div> #}

              {# Email address #}
              {{ govukInput({
                label: {
                  text: "Email address"
              },
                id: "contact-details-email",
                classes: "govuk-!-width-three-quarters",
                name: "contact-details-email",
                type: "email",
                autocomplete: "email",
                value: data['contact-details-email'],
                spellcheck: false
              }) }}

              {# Phone number #}
              {# <div class="govuk-form-group">
                <label class="govuk-label" for="phone-number">
                  UK phone number
                </label>
                <input class="govuk-input govuk-input--width-20" id="phone-number" name="contact-details-phoneNumber" type="tel" autocomplete="tel">
              </div> #}

              {# Phone number #}
              {{ govukInput({
                label: {
                  text: "UK phone number (Optional)"
                },
                id: "contact-details-phoneNumber",
                name: "contact-details-phoneNumber",
                type: "tel",
                autocomplete: "tel",
                value: data['contact-details-phoneNumber'],
                classes: "govuk-input--width-20"
              }) }}

          </fieldset>
        </div>

        <div class="govuk-button-group">
          {{ govukButton({
            text: "Continue"
          }) }}

          <a class="govuk-link" href="contacts">Cancel</a>
        </div>
      
      </form>

    </div>
  </div>

{% endblock %}

{% block footer %}
  {% include "/layouts/rsd-footer.html" %}
{% endblock %}
