{% extends "layouts/main.html" %}

{% block pageTitle %}
  Question page template – {{ serviceName }} – GOV.UK Prototype Kit
{% endblock %}

{% block beforeContent %}
  {{ govukBackLink({
    text: "Back",
    href: "javascript:window.history.back()"
  }) }}
{% endblock %}

{% block header %}
  {% include "/layouts/dfe-header.html" %}
{% endblock %}

{% block content %}

<div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">

    <span class="govuk-caption-l">Cheltenham Spa Primary School</span>
    <h2 class="govuk-heading-l">Change reason the intervention has paused</h2>
      
    <form class="form" action='project-status-answers' method="post">
  
      {% set newHtml %}
        {{ govukTextarea({
          name: "new-report-details",
          id: "new-report-details",
          title: "New report details",
          value: data["new-report-details"],
          label: {
            text: "Give details about the new Ofsted judgement."
          }
        }) }}
      {% endset %}

      {% set appealHtml %}
        {{ govukTextarea({
          name: "appeal-details",
          id: "appeal-details",
          title: "Appeal details",
          value: data["appeal-details"],
          label: {
            text: "Give details about the appeal."
          }
        }) }}
      {% endset %}

      {% set changeHtml %}
        {{ govukTextarea({
          name: "proposed-change-details",
          id: "proposed-change-details",
          title: "Proposed change details",
          value: data["Proposed-change-details"],
          label: {
            text: "Give details about the proposed change."
          }
        }) }}
      {% endset %}

      {% set protectHtml %}
        {{ govukTextarea({
          name: "protection-details",
          id: "protection-details",
          title: "Protecting school staff details",
          value: data["protection-details"],
          label: {
            text: "Give details about the proposed change."
          }
        }) }}
      {% endset %}

      {{ govukRadios({
        name: "project-status-paused",
        items: [
          {
            value: "Awaiting new Ofsted judgement",
            text: "Awaiting new Ofsted judgement",
            checked:  data['project-status-paused'] === "Awaiting new Ofsted judgement",
            hint: {
              text: "Ofsted have inspected the school. The report is not yet published on the Ofsted website."
            },
            conditional: {
              html: newHtml
            }
          },
          {
            value: "Appealing Ofsted judgement",
            text: "Appealing Ofsted judgement",
            checked:  data['project-status-paused'] === "Appealing Ofsted judgement",
            hint: {
              text: "The school or its responsible body are appealling Ofsted's most recent inspection result."
            },
            conditional: {
              html: appealHtml
            }
          },
          {
            value: "Considering structural or governance change",
            text: "Considering structural or governance change",
            checked:  data['project-status-paused'] === "Considering structural or governance change",
            hint: {
              text: "The school has applied to convert, transfer or make another type of governance change. Or it is waiting on the outcome of a DfE decision to approve a conversion, transfer or other type of governance change."
            },
            conditional: {
              html: changeHtml
            }
          },
          {
            value: "Protecting school staff health and wellbeing",
            text: "Protecting school staff health and wellbeing",
            checked:  data['project-status-paused'] === "Protecting school staff health and wellbeing",
            hint: {
              text: "Work is temporariliy pausing to protect the mental or physical health and wellbeing of a particular member of staff in the school leadership, such as the headteacher."
            },
            conditional: {
              html: protectHtml
            }
          }
        ]
      }) }}

      {{ govukButton({
        text: "Save and continue"
      }) }}

    </form>

  </div>
</div>
{% endblock %}

{% block footer %}
{% include "/layouts/rsd-footer.html" %}
{% endblock %}