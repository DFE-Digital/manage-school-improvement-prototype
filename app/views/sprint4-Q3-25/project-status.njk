{% extends "layouts/main.html" %}

{% set NavActive = "project-status" %}

{% set inProgress %}
  <strong class="govuk-tag govuk-tag--green">
    In progress
  </strong>
{% endset %}

{% set paused %}
  <strong class="govuk-tag govuk-tag--orange">
    Paused
  </strong>
{% endset %}

{% set stopped %}
  <strong class="govuk-tag govuk-tag--red">
    Stopped
  </strong>
{% endset %}

{% set pausedReason = "" %}
  {% if (data['project-status-paused'] == 'Awaiting new Ofsted judgement') %}
    {% set pausedReason = data['new-report-details'] %}
  {% endif %}

  {% if (data['project-status-paused'] == 'Appealing Ofsted judgement') %}
    {% set pausedReason = data['appeal-details'] %}
  {% endif %}

  {% if (data['project-status-paused'] == 'Considering structural or governance change') %}
    {% set pausedReason = data['proposed-change-details'] %}
  {% endif %}

  {% if (data['project-status-paused'] == 'Protecting school staff health and wellbeing') %}
    {% set pausedReason = data['protection-details'] %}
  {% endif %}

{% block pageTitle %}
  Task list template – {{ serviceName }} – GOV.UK Prototype Kit
{% endblock %}

{% block header %}
  {% include "/layouts/dfe-header.html" %}
{% endblock %}

{% block beforeContent %}
  {{ govukBackLink({
    text: "Back",
    href: "javascript:window.history.back()"
  }) }}

  {% if (data['project-status'] == "Paused") %}
    <div class="govuk-grid-row">
      <div class="govuk-grid-column-two-thirds">
        <div class="govuk-notification-banner govuk-!-margin-bottom-3" role="region" aria-labelledby="govuk-notification-banner-title" data-module="govuk-notification-banner">
          <div class="govuk-notification-banner__header">
            <h2 class="govuk-notification-banner__title" id="govuk-notification-banner-title">
              Important
            </h2>
          </div>
          <div class="govuk-notification-banner__content">
            <p class="govuk-notification-banner__heading">
              Intervention paused.
            </p>
            <p>Targeted intervention at this school is paused while Ofsted write a new inspection report.</p>
          </div>
        </div>
      </div>
    </div>
  {% endif %}

  {% if (data['project-status'] == "Stopped") %}
    <div class="govuk-grid-row">
      <div class="govuk-grid-column-two-thirds">
        <div class="govuk-notification-banner govuk-!-margin-bottom-3" role="region" aria-labelledby="govuk-notification-banner-title" data-module="govuk-notification-banner">
          <div class="govuk-notification-banner__header">
            <h2 class="govuk-notification-banner__title" id="govuk-notification-banner-title">
              Important
            </h2>
          </div>
          <div class="govuk-notification-banner__content">
            <p class="govuk-notification-banner__heading">
              Intervention stopped.
            </p>
            <p class="govuk-body">Targeted intervention at this school has stopped.</p>
            <p class="govuk-body">The school to will convert, transfer or undergo another type of governance change.</p>
            <p class="govuk-body">You cannot make changes to this project.</p>
          </div>
        </div>
      </div>
    </div>
  {% endif %}
{% endblock %}

{% block content %}

  <div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
      {% include "/layouts/summary-section.html" %}
    </div>
  </div>

  <div class="govuk-grid-row">
    <div class="govuk-grid-column-full">
      {% include "/layouts/sub-nav-tabs-all.html" %}
    </div>
  </div>

  <div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">

      <h2 class="govuk-heading-l">Project status</h2>

      {% if (data['project-status'] != "Paused") and (data['project-status'] != "Stopped") %}
        <p>Change the status of a project if targeted intervention work pauses or stops.</p>
      {% endif %}

      {% if (data['project-status'] == "Stopped") and (data['project-status-stopped'] == "Publication of improved Ofsted judgement") or (data['project-status-stopped'] == "Approval of structural or governance change") %}
        
        {{ govukSummaryList({
          rows: [
            {
              key: {
                text: "Current status"
              },
              value: {
                html: stopped
              }
            },
            {
              key: {
                text: "Reason"
              },
              value: {
                html: data['project-status-stopped']
              }
            },
            {
              key: {
                text: "Details"
              },
              value: {
                html: data['improved-details']
              }
            },
            {
              key: {
                text: "Date of decision"
              },
              value: {
                html: data | isoDateFromDateInput("intervention-stopped-date") | govukDate
              }
            },
            {
              key: {
                text: "Additional details"
              },
              value: {
                html: data['stopped-notes']
              }
            }
          ]
        }) }}

      {% elif (data['project-status'] == "Paused") %}

        {{ govukSummaryList({
          rows: [
            {
              key: {
                text: "Current status"
              },
              value: {
                html: paused
              }
            },
            {
              key: {
                text: "Reason"
              },
              value: {
                html: data['project-status-paused']
              }
            },
            {
              key: {
                text: "Details"
              },
              value: {
                html: pausedReason
              }
            },
            {
              key: {
                text: "Date of decision"
              },
              value: {
                html: data | isoDateFromDateInput("intervention-paused-date") | govukDate
              }
            },
            {
              key: {
                text: "Additional details"
              },
              value: {
                html: data['paused-notes']
              }
            }
          ]
        }) }}

      {% else %}

        {{ govukSummaryList({
          rows: [
            {
              key: {
                text: "Current status"
              },
              value: {
                html: inProgress
              }
            }
          ]
        }) }}

      {% endif %}

      {{ govukButton({ 
        text: "Change project status", 
        href: "project-status/change-project-status" }) 
      }}

    </div>
  </div>

{% endblock %}

{% block footer %}
  {% include "/layouts/rsd-footer.html" %}
{% endblock %}
