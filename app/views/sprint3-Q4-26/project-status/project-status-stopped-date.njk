{% extends "layouts/main.html" %}

{% block pageTitle %}
  Question page template – {{ serviceName }} – GOV.UK Prototype Kit
{% endblock %}

{% block beforeContent %}
  {{ govukBackLink({
    text: "Back",
    href: "javascript:window.history.back()"
  }) }}
{% endblock %}

{% block header %}
  {% include "/layouts/dfe-header.html" %}
{% endblock %}

{% block content %}

<div class="govuk-grid-row">
  
  <div class="govuk-grid-column-two-thirds">
    <span class="govuk-caption-l">Cheltenham Spa Primary School</span>
    <h2 class="govuk-heading-l">Enter date the intervention stopped</h2>
    <p>This must be the date a decision to convert, transfer or undergo another governance change was approved.</p>
      
    <form class="form" action='project-status-stopped-notes' method="post">

      {{ govukDateInput({
        id: "intervention-stopped-date",
        namePrefix: "intervention-stopped-date",
        fieldset: {
          legend: {
            text: "Enter date stopped",
            isPageHeading: true,
            classes: "govuk-fieldset__legend--m"
          }
        },
        hint: {
          text: "For example, 27 3 2007."
        },
        items: [
          {
            name: "day",
            value: data["intervention-stopped-date-day"],
            allowEmpty: false,
            classes: "govuk-input--width-2"
          },
          {
            name: "month",
            value: data["intervention-stopped-date-month"],
            allowEmpty: false,
            classes: "govuk-input--width-2"
          },                
          {
            name: "year",
            value: data["intervention-stopped-date-year"],
            allowEmpty: false,
            classes: "govuk-input--width-4"
          }
        ]
      }) }}

      {{ govukButton({
        text: "Continue"
      }) }}

    </form>
  </div>
</div>

{% endblock %}

{% block footer %}
  {% include "/layouts/rsd-footer.html" %}
{% endblock %}