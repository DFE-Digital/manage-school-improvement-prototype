{% extends "../includes/form-template.html" %}

{% extends "layouts/main.html" %}

{% block pageTitle %}
  Content page template – {{ serviceName }} – GOV.UK Prototype Kit
{% endblock %}

{% block header %}
{% include "/layouts/dfe-header.html" %}
{% endblock %}

{# Old values for the auto complete #}
{# { text: "Alex James (alex.james-RISE@education.gov.uk)" },
{ text: "Alex Smith (alex.smith-RISE@education.gov.uk)" },
{ text: "Alexander McTavish (alexander.mctavish-RISE@education.gov.uk)" },
{ text: "Alexandria Taylor (alexandria.taylor-RISE@education.gov.uk)" } #}

{% block beforeContent %}
  
  {{ govukBackLink({
    text: "Back",
    href: "javascript:window.history.back()"
  }) }}

{% endblock %}

{% block content %}

<div class="govuk-grid-row">
  <div class="govuk-grid-column-two-thirds">

    <span class="govuk-caption-l">Cheltenham Spa Primary School</span>
    <h1 class="govuk-heading-l">
      Allocate an adviser
    </h1>

  </div>
</div>

<div class="govuk-grid-row">
  <div class="govuk-grid-column-two-thirds">

    <p>Enter the name of the adviser and the date they were allocated to this school.</p>

    <form class="form" action="../task-list-task-updated" method="post">

    {% block formQuestions %}
        
      {{ xGovukAutocomplete({
        id: "allocated-adviser-email",
        name: "allocated-adviser-email",
        value: data['allocated-adviser-email'],
        label: {
          text: "Enter the name of the adviser",
          classes: "govuk-label--m",
          isPageHeading: true
        },
        allowEmpty: false,
        items: [
          { text: "Alex James" },
          { text: "Alex Smith" },
          { text: "Alexander McTavish" },
          { text: "Alexandria Taylor" }
        ]
       }) }}

      {{ govukDateInput({
        id: "adviser-allocated-date",
        namePrefix: "adviser-allocated-date",
        fieldset: {
          legend: {
            text: "Enter the date the adviser was allocated",
            isPageHeading: true,
            classes: "govuk-fieldset__legend--m"
          }
        },
        hint: {
          text: "For example, 1 7 2024."
        },
        items: [
          {
            name: "day",
            value: data["adviser-allocated-date-day"],
            allowEmpty: true,
            classes: "govuk-input--width-2"
          },
          {
            name: "month",
            value: data["adviser-allocated-date-month"],
            classes: "govuk-input--width-2"
          },                
          {
            name: "year",
            value: data["adviser-allocated-date-year"],
            classes: "govuk-input--width-4"
          }
        ]
      }) }}

      {{ govukButton({
        text: "Save and return"
      }) }}
        
      </form>

    </div>
  </div>

  {% endblock %}

{% endblock %}

{% block footer %}
  {% include "/layouts/rsd-footer.html" %}
{% endblock %}
