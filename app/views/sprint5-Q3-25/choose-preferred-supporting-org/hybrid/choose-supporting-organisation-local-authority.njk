{% extends "../../includes/form-template.html" %}

{% extends "layouts/main.html" %}

{% block pageTitle %}
  Content page template – {{ serviceName }} – GOV.UK Prototype Kit
{% endblock %}

{% block header %}
  {% include "/layouts/dfe-header.html" %}
{% endblock %}

{% block beforeContent %}
  {{ govukBackLink({
    text: "Back",
    href: "javascript:window.history.back()"
  }) }}
{% endblock %}

{% block content %}

<div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">  
  
      <span class="govuk-caption-l">Cheltenham Spa Primary School</span>
      <h1 class="govuk-heading-l">
        Enter supporting organisation details
      </h1>

      <form action="confirm-so-la-details" method="post" novalidate>
        {% block formQuestions %}

        {% set hintText %}
          Search by the Local Authority name, or by the 3 digit GIAS LA name code. 
          <br><a href="https://get-information-schools.service.gov.uk/Guidance/LaNameCodes" target="_blank" rel="noopener noreferrer">Find an LA's name code in Get information about schools (opens in new tab)</a>
        {% endset %}
          
          {{ xGovukAutocomplete({
            id: "supporting-organisation-name",
            name: "supporting-organisation-name",
            value: data['supporting-organisation-name'],
            allowEmpty: false,
            hint: {
              html: hintText
            },
            items: [
              { text: "Barking and Dagenham (301)" },
              { text: "Barnet (302)" },
              { text: "Barnsley (370)" },
              { text: "Bath and North East Somerset (800)" }
            ]
          }) }}

          <div class="govuk-button-group">
            <button type="submit" class="govuk-button" data-module="govuk-button">
                Continue
            </button>
          </div>

        {% endblock %}
      </form>

    </div>
  </div>
{% endblock %}

{% block footer %}
  {% include "/layouts/rsd-footer.html" %}
{% endblock %}