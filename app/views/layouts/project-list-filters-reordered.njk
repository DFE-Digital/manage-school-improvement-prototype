<div class="moj-filter">

    <div class="moj-filter__header">

        <div class="moj-filter__header-title">
            <h2 class="govuk-heading-m">Filter</h2>
        </div>
        <div class="moj-filter__header-action">
        </div>

    </div>

    <div class="moj-filter__content">
        
        <div if="Model.IsVisible" class="moj-filter__selected">

            <div class="moj-filter__selected-heading">
                <div class="moj-filter__heading-title">
                    <h2 class="govuk-heading-m">Selected filters</h2>
                </div>

                <div class="moj-filter__heading-action">
                    <p><a class="govuk-link govuk-link--no-visited-state" data-cy="clear-filter" href="../sprint2-Q3-25/project-list-filters-reordered-results" id="reset-checkboxes">Clear filters</a></p>
                </div>
            </div>
              
            <!-- Example filter tags but works with year and months only -->
            <!-- The only ones working are Jan/Feb/March 2024 and same for 2025  -->
            <!-- {% set years = data['date-year'] %} -->
            {% set months = data['month'] %}

            {% if (months != NULL) %}
            <h3 class="govuk-heading-s govuk-!-margin-bottom-0">Date school added to MSI</h3>
            <ul class="moj-filter-tags">
                {% for month in months %} 
                    <li>
                        <a class="moj-filter__tag">
                            <span class="govuk-visually-hidden">Remove this filter</span> 
                             {{ month }}
                        </a>
                    </li>
                {% endfor %}
            </ul>
            {% else %}
                <p class="govuk-body govuk-!-margin-bottom-2">No filters selected.</p>               
            {% endif %}
        </div>

        <div class="moj-filter__options">
            <form method="get" action="project-list-filters-reordered-results" class="form">
               
                <!-- Filter by finding a school name or URN -->
                <div class="govuk-form-group">
                    <label class="govuk-label govuk-label--m" for="projects">
                        Find a school
                    </label>
                    <span class="govuk-hint">You can filter by school name or URN (unique reference number)</span>
                    <input id="Title" name="Title" type="text" class="govuk-input govuk-!-margin-top-3" aria-describedby="filter-project-title-hint" data-cy="select-projectlist-filter-title" value="">
                </div>

                <!-- All other types of filtering -->
                <div class="govuk-form-group">

                    <fieldset class="govuk-fieldset">
                        <div class="govuk-accordion" data-module="govuk-accordion" id="accordion-default">

