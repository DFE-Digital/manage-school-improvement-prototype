{% extends "../includes/form-template.html" %}

{% extends "layouts/main.html" %}

{% block pageTitle %}
  Content page template – {{ serviceName }} – GOV.UK Prototype Kit
{% endblock %}

{% block header %}
{% include "/layouts/dfe-header.html" %}
{% endblock %}

{% block beforeContent %}
  
  {{ govukBackLink({
    text: "Back",
    href: "javascript:window.history.back()"
  }) }}

{% endblock %}

{% block content %}

<div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">  

    <!--<span class="govuk-caption-l">Cheltenham Spa Primary School</span>-->
  
      <span class="govuk-caption-xl">Cheltenham Spa Primary School</span>
      <h1 class="govuk-heading-l">
        Which adviser will work with this school?
      </h1>

      <form action="../task-list" method="post" novalidate>

      {% block formQuestions %}
        
      {{ xGovukAutocomplete({
        id: "allocated-adviser",
        name: "allocated-adviser",
        value: data['allocated-adviser'],
        allowEmpty: false,
        hint: {
          text: "Enter the person's name."
        },
        items: [
          { text: "Alan Smith" },
          { text: "Alex Alexander" },
          { text: "Alex James" },
          { text: "Alice Cooper" }
        ]
       }) }}

      <div class="govuk-button-group">
        <button type="submit" class="govuk-button" data-module="govuk-button">
            Allocate
        </button>
        or&nbsp;&nbsp;<a class="govuk-link" href="">Unallocate</a>
      </div>

    </form>
 
  {% endblock %}

{% endblock %}

{% block footer %}
  {% include "/layouts/rsd-footer.html" %}
{% endblock %}