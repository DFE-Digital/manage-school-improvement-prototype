{% extends "layouts/main.html" %}

{% set NavActive = "case-study" %}

{% block pageTitle %}
  Task list template – {{ serviceName }} – GOV.UK Prototype Kit
{% endblock %}

{% block header %}
{% include "/layouts/dfe-header.html" %}
{% endblock %}

{% block beforeContent %}
  {{ govukBackLink({
    text: "Back",
    href: "javascript:window.history.back()"
  }) }}

  <div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
      {% include "sprint1-Q4-26/includes/status-notification-banner.njk" %}
    </div>
  </div>
{% endblock %}

{% block content %}
  <div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">

      {% include "/layouts/summary-section.html" %}

    </div>
  </div>

  <div class="govuk-grid-row">
    <div class="govuk-grid-column-full">

      {% include "/layouts/sub-nav-tabs-all.html" %}

      </div>
    </div>

    <div class="govuk-grid-row">
      <div class="govuk-grid-column-two-thirds">

      <h2 class="govuk-heading-l">Case study</h2>


      {% if (data['case-study-candidate'] == NULL) %}

      <p>DfE want to identify schools that have had particularly good or bad experiences of the RISE intervention.</p>
      <p>If you think this school is a useful example, enter details about its progress.</p>
      <p>This will be used by the department to understand how to improve the process.</p>

      <div class="govuk-!-margin-top-5">
        {{ govukButton({ text: "Enter case study details", href: "flag-as-case-study" }) }}
      </div>

     
      {% else %}

     


      <div class="govuk-inset-text">
       
        
        <p>This school might be used as a case study.</p>
      </div>
      
      <h2 class="govuk-heading-m">Details</h2>

      <p>{{ data['case-study-reasons']}}</p>

      <div class="govuk-!-margin-top-5">
        {{ govukButton({ text: "Update details", href: "flag-as-case-study" }) }}
      </div>
      
      {% endif %}


     

        </div>
      </div>
      

    
      <!--
      <div class="govuk-!-margin-top-5">
        {{ govukButton({ text: "Add note", href: "#" }) }}
      </div>
      -->

    </div>
  </div>
{% endblock %}

{% block footer %}
{% include "/layouts/rsd-footer.html" %}
{% endblock %}
