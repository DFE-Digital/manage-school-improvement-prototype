{% extends "../includes/form-template.html" %}

{% extends "layouts/main.html" %}

{% block pageTitle %}
  Content page template – {{ serviceName }} – GOV.UK Prototype Kit
{% endblock %}

{% block header %}
  {% include "/layouts/dfe-header.html" %}
{% endblock %}

{% block beforeContent %}
  {{ govukBackLink({
    text: "Back",
    href: "javascript:window.history.back()"
  }) }}
{% endblock %}

{% block content %}

<div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">  

      <span class="govuk-caption-l">Enter supporting organisation details</span>
      <h1 class="govuk-heading-l">
        Enter the name of the local authority's traded service
      </h1>

      <form action="confirm-so-la-traded-service-contact-details" method="post" novalidate>

      {% block formQuestions %}
        
      {{ xGovukAutocomplete({
        id: "supporting-organisation-name",
        name: "supporting-organisation-name",
        value: data['supporting-organisation-name'],
        allowEmpty: false,
        items: [
          { text: "An example LA traded service (17642365)" },
          { text: "Another LA traded service (12874387)" },
          { text: "Again another LA traded service (1864299)" },
          { text: "Another another another LA traded service (1544421)" }
        ]
       }) }}

      <div class="govuk-button-group">
        <button type="submit" class="govuk-button" data-module="govuk-button">
            Continue
        </button>
      </div>

    </form>
 
  {% endblock %}

{% endblock %}

{% block footer %}
  {% include "/layouts/rsd-footer.html" %}
{% endblock %}