{% extends "layouts/main.html" %}

{% block pageTitle %}
  Question page template – {{ serviceName }} – GOV.UK Prototype Kit
{% endblock %}

{% block beforeContent %}
  
  {{ govukBackLink({
    text: "Back",
    href: "javascript:window.history.back()"
  }) }}

  <!--
  <div class="govuk-breadcrumbs">
    <ol class="govuk-breadcrumbs__list">
      <li class="govuk-breadcrumbs__list-item">
        <a class="govuk-breadcrumbs__link" href="https://www.gov.uk">Home</a>
      </li>
      <li class="govuk-breadcrumbs__list-item">
        <a class="govuk-breadcrumbs__link" href="#">Section</a>
      </li>
      <li class="govuk-breadcrumbs__list-item">
        <a class="govuk-breadcrumbs__link">Subsection</a>
      </li>
    </ol>
  </div>
  -->

{% endblock %}

{% block header %}
{% include "/layouts/dfe-header.html" %}
{% endblock %}

{% block content %}

  <div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">

     

      <span class="govuk-caption-l">Cheltenham Spa Primary School</span>
      <h1 class="govuk-heading-l">
       Add school contact
      </h1>
      
      <form class="form" action='add-contact-details' method="post">

        

    
        {% from "govuk/components/radios/macro.njk" import govukRadios %}
        {% from "govuk/components/input/macro.njk" import govukInput %}


    
       
        
        {% set otherschoolHtml %}
        {{ govukInput({
          id: "other-role-school-title",
          name: "other-role-school-title",
          spellcheck: false,
          classes: "govuk-!-width-one-half"
        }) }}
        {% endset -%}
        
        {{ govukRadios({
          name: "job-title",
          fieldset: {
            legend: {
              text: "Role",
              isPageHeading: true,
              classes: "govuk-fieldset__legend--m"
            }
          },
          hint: {
            text: "Select one option"
          },
          items: [
          {
            value: "Headteacher",
            text: "Headteacher",
            checked:  data['job-title'] === "Headteacher"
          },
          {
            value: "Chair of governors",
            text: "Chair of governors",
            checked:  data['job-title'] === "Chair of governors"
          },
          {
            value: "Accounting officer for school",
            text: "Accounting officer for school",
            checked:  data['job-title'] === "Accounting officer for school"
          },
          {
            text: "Other role",
            checked: false,
            conditional: {
            html: otherschoolHtml
              }
            } 
          ]
        }) }}
    

{{ govukButton({
  text: "Continue"
}) }}
      


      </form>

    </div>
  </div>

{% endblock %}

{% block footer %}
{% include "/layouts/rsd-footer.html" %}
{% endblock %}
