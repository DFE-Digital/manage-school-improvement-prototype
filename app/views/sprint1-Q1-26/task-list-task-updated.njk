{% extends "layouts/main.html" %}

{# SET CURRENT STATUS #}
{% set currentStatus = "" %}
{% if (data['project-status'] == "Paused") %}
  {% set currentStatus = '<strong class="govuk-tag govuk-tag--yellow">Paused</strong>' %}
{% elif (data['project-status'] == "Stopped") %}
  {% set currentStatus = '<strong class="govuk-tag govuk-tag--red">Stopped</strong>' %}
{% else %}
  {% set currentStatus = '<strong class="govuk-tag govuk-tag--green">In progress</strong>' %}
{% endif %}

{# SET TASK LIST TAGS #}
{% set cannotStartYet %}
  <strong class="govuk-tag govuk-tag--grey">
    Cannot start yet
  </strong>
{% endset %}

{% set cannotProgress %}
<strong class="govuk-tag govuk-tag--grey">
  Cannot progress
</strong>
{% endset %}

{% set notRequired %}
<strong class="govuk-tag govuk-tag--grey">
  Not required
</strong>
{% endset %}

{% set notStarted %}
<strong class="govuk-tag govuk-tag--blue">
  Not started
</strong>
{% endset %}

{% set completed %}
<strong class="govuk-tag govuk-tag--turquoise">
  Completed
</strong>
{% endset %}

{% set inProgress %}
<strong class="govuk-tag govuk-tag--orange">
  In progress
</strong>
{% endset %}

{# SET ACTIVE NAV ITEM #}
{% set NavActive = "task-list" %}

{# The three tasks - 1. Check potential adviser conflicts of interest #}
{% set checkAdviserConflictComplete = "" %}
{% if (data['conflicts-form-sent'] == 'done') and (data['conflicts-of-interest-date-day'] != '') %}
  {% set checkAdviserConflictComplete = "Complete" %}
{% endif %}

{# The three tasks - 2. Send the formal notification #}
{% set sendFormalNotificationComplete = "" %}
{% if (data['draft-email'] == 'done') and (data['add-attachments'] == 'done') and (data['add-recipients'] == 'done') and (data['email-responsible-body'] == 'done') and (data['school-contacted-date-day'] != '') %}
  {% set sendFormalNotificationComplete = "Complete" %}
{% endif %}

{# The three tasks - 3. Record the responsible body's response to the conflict of interest form #}
{% set recordResponsibleBodyReponseComplete = "" %}
{% if (data['response-saved'] == 'done') and (data['school-response-date-day'] != '') %}
  {% set recordResponsibleBodyReponseComplete = "Complete" %}
{% endif %}

{# Check if allocate an adviser is complete or not #}
{% set allocateAnAdviserComplete = "" %}
{% if (data['allocated-adviser-email'] != NULL) and (data['adviser-allocated-date-day'] != '') %}
  {% set allocateAnAdviserComplete = "Complete" %}
{% endif %}

{% block pageTitle %}
  Task list template – {{ serviceName }} – GOV.UK Prototype Kit
{% endblock %}

{% block header %}
  {% include "/layouts/dfe-header.html" %}
{% endblock %}

{% block beforeContent %}
  {{ govukBackLink({
    text: "Back",
    href: "javascript:window.history.back()"
  }) }}

  <div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">

      {% set successHTML %}
        <h3 class="govuk-notification-banner__heading">
          Task updated successfully
        </h3>
      {% endset %}

      {{ govukNotificationBanner({
        html: successHTML,
        type: "success",
        classes: "govuk-!-margin-bottom-2"
      }) }}

      {% include "sprint1-Q1-26/includes/status-notification-banner.njk" %}
    
    </div>
  </div>
  
{% endblock %}

{% block content %}
  
  <div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
      {% include "/layouts/summary-section.html" %}
    </div>
  </div>

  <div class="govuk-grid-row">
    <div class="govuk-grid-column-full">
      {% include "/layouts/sub-nav-tabs-all.html" %}
    </div>
  </div>

  <div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">

