            {# Confirm starting eligibility #}
          {# {% else %} #}
            <a class="govuk-link govuk-task-list__link" href="task-list/eligibility-check" aria-describedby="company-details-2-status">
              Confirm starting eligibility
            </a>
          {# {% endif %} #}
        </div>

        <div class="govuk-task-list__status" id="company-details-2-status">
          {# {% if (data['assigned-to'] == NULL) %}
            {% set taskStatusTag = cannotStartYet %}
            {{ taskStatusTag | safe }}
          {% elif (data['project-status'] == "Stopped") or (data['project-status'] == "Paused") %}
            {% set taskStatusTag = cannotProgress %}
            {{ taskStatusTag | safe }}
          {% elif (data['project-status'] == "In progress") and (data['starting-eligibility'] == NULL) %}
            {% set taskStatusTag = notStarted %}
            {{ taskStatusTag | safe }}
          {% else %}
            {% set taskStatusTag = completed %}
            {{ taskStatusTag | safe }}
          {% endif %} #}

          {# {% if (data['starting-eligibility'] == "Yes") %}
            {% set taskStatusTag = completed %}
            {{ taskStatusTag | safe }}
          {% endif %} #}

          {% set taskStatusTag = completed %}
