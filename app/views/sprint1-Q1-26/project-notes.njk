{% extends "layouts/main.html" %}

{% set NavActive = "project-notes" %}

{% block pageTitle %}
  Task list template – {{ serviceName }} – GOV.UK Prototype Kit
{% endblock %}

{% block header %}
{% include "/layouts/dfe-header.html" %}
{% endblock %}

{% block beforeContent %}
  {{ govukBackLink({
    text: "Back",
    href: "javascript:window.history.back()"
  }) }}

  <div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
      {% include "sprint1-Q1-26/includes/status-notification-banner.njk" %}
    </div>
  </div>
{% endblock %}

{% block content %}
  <div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">

      {% include "/layouts/summary-section.html" %}

    </div>
  </div>

  <div class="govuk-grid-row">
    <div class="govuk-grid-column-full">

      {% include "/layouts/sub-nav-tabs-all.html" %}

      </div>
    </div>

    <div class="govuk-grid-row">
      <div class="govuk-grid-column-two-thirds">

      <h2 class="govuk-heading-l">Notes</h2>

      <div class="govuk-!-margin-top-5">
        {{ govukButton({ text: "Add note", href: "add-note" }) }}
      </div>

      {% if (data['task-note'] != NULL) %}

      <hr class="govuk-section-break govuk-section-break--m govuk-section-break--visible">
      

      <p> 10 March 2025
        <strong class="govuk-tag govuk-tag--green">
          New
        </strong>
        <strong class="govuk-tag govuk-tag--yellow">
          Task note
        </strong>
        
        <br>
      <strong>Bob Roberts</strong></p>
      <p>{{ data['task-note']}}</p>
      <p>
        <a href="../task-notes/contact-the-school.html">Edit note</a>
      </p>
      {% endif %}

      {% if (data['project-note'] != NULL) %}   
      <hr class="govuk-section-break govuk-section-break--m govuk-section-break--visible">
      <p>1 March 2025
        <strong class="govuk-tag govuk-tag--blue">
          Project note
        </strong>
        <br>
      <strong>Bob Roberts</strong></p>
      <p>{{ data['project-note']}}</p>
      <p>
        <a href="add-note">Edit note</a>
      </p>
      <hr class="govuk-section-break govuk-section-break--visible">
      {% endif %}


      
     

        </div>
      </div>
      

    
      <!--
      <div class="govuk-!-margin-top-5">
        {{ govukButton({ text: "Add note", href: "#" }) }}
      </div>
      -->

    </div>
  </div>
{% endblock %}

{% block footer %}
{% include "/layouts/rsd-footer.html" %}
{% endblock %}
